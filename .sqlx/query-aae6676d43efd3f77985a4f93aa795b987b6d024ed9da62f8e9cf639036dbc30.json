  "db_name": "SQLite",
  "query": "\n        SELECT *\n        FROM releases\n        WHERE release_type = ?\n          AND archived = 0\n          AND (? IS NULL OR version_integral >= ?)\n          AND (? IS NULL OR version_integral <= ?)\n          AND (? IS NULL OR version_integral < ?)\n        ORDER BY version_integral DESC\n        LIMIT ?;\n        ",
